+  // Red: keep the stream and give the client a proxied end (see SetVolume).
+  // Closing either end closes the other, as with the direct connection.
+  // Unretained is safe because |this| owns both.
+  stream_.Bind(std::move(stream));
+  stream_.set_disconnect_handler(base::BindOnce(
+      [](AudioLoopbackStreamBroker* self) { self->proxy_receiver_.reset(); },
+      base::Unretained(this)));
+  if (source_muted_) {
