+void AudioLoopbackStreamBroker::OnSourceMuted(bool muted) {
+  CHECK_CURRENTLY_ON(BrowserThread::IO, base::NotFatalUntil::M160);
+  source_muted_ = muted;
+  if (stream_) {
+    stream_->SetVolume(source_muted_ ? 0.0 : volume_);
+  }
+}
+
+void AudioLoopbackStreamBroker::Record() {
+  CHECK_CURRENTLY_ON(BrowserThread::IO, base::NotFatalUntil::M160);
+  if (stream_) {
+    stream_->Record();
+  }
+}
+
+void AudioLoopbackStreamBroker::SetVolume(double volume) {
+  CHECK_CURRENTLY_ON(BrowserThread::IO, base::NotFatalUntil::M160);
+  // The audio service validates the range and reports bad values.
+  volume_ = volume;
+  if (stream_) {
+    stream_->SetVolume(source_muted_ ? 0.0 : volume_);
+  }
+}
