+  auto proxy = proxy_receiver_.BindNewPipeAndPassRemote();
+  proxy_receiver_.set_disconnect_handler(base::BindOnce(
+      [](AudioLoopbackStreamBroker* self) { self->stream_.reset(); },
+      base::Unretained(this)));
   renderer_factory_client_->StreamCreated(
-      std::move(stream), std::move(client_receiver_), std::move(data_pipe),
+      std::move(proxy), std::move(client_receiver_), std::move(data_pipe),
       false /* |initially_muted|: Loopback streams are never muted. */,
       std::nullopt /* |stream_id|: Loopback streams don't have ids */);
