+void VideoOverlayWindowViews::SliderValueChanged(
+    views::Slider* sender,
+    float value,
+    float old_value,
+    views::SliderChangeReason reason) {
+  if (sender != volume_slider_ || reason != views::SliderChangeReason::kByUser) {
+    return;
+  }
+  controller_->SetVolume(value);
+  // Raising the volume of muted media unmutes it, as in Chrome's media controls.
+  if (value > 0 && controller_->GetMuteStatus()) {
+    controller_->RequestMute(false);
+  }
+}
